# /etc/nginx/sites-available/id-card: serves the static export in out/ at
# https://id.scascollege.ac.in. Everything (Excel parsing, photos, rendering,
# ZIP/PDF) runs in the browser; nginx only hands out files that
# deploy/precompress.mjs already gzipped.
#
# The certificate comes from Let's Encrypt (certbot, see deploy/README.md) and
# certbot.timer renews it. Run certbot once before installing this file: nginx
# refuses to start if the certificate files below don't exist yet.

# Plain http only redirects.
server {
    listen 80;
    listen [::]:80;
    server_name id.scascollege.ac.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name id.scascollege.ac.in;

    ssl_certificate /etc/letsencrypt/live/id.scascollege.ac.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/id.scascollege.ac.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/id-card;
    index index.html;

    gzip off;
    gzip_static on;

    error_page 404 /404.html;

    # Hashed build output never changes under the same name.
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    location /card-assets/ {
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    # Next 16 prefetches "__next.<seg>.__PAGE__.txt" but the export writes
    # "__next.<seg>/__PAGE__.txt" (see e2e/serve.mjs).
    location ~ ^(?<seg>.*/__next\.[^/]+)\.__PAGE__\.txt$ {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        try_files $uri $seg/__PAGE__.txt =404;
    }

    # Pages (/review, /editor?i=3, /generate) and their .txt payloads:
    # revalidate so a new deploy shows up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        add_header Referrer-Policy no-referrer;
        try_files $uri $uri.html $uri/index.html =404;
    }
}
